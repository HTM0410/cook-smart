{
  "containerDefinitions": [
    {
      "name": "cooksmart-backend",
      "image": "294060270105.dkr.ecr.ap-southeast-1.amazonaws.com/cooksmart-backend:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {"name": "YOLO_RETRY_DELAY", "value": "1500"},
        {"name": "CORS_ORIGIN_REGEX", "value": "^https://[a-zA-Z0-9-]+\\.netlify\\.app$,^https://.*\\.cooksmart\\.click$,^http://localhost(:\\d+)?$"},
        {"name": "SUPABASE_DB_USER", "value": "postgres.<PLACEHOLDER>"},
        {"name": "YOLO_INFERENCE_TIMEOUT", "value": "30000"},
        {"name": "SUPABASE_URL", "value": "https://<PLACEHOLDER>.supabase.co"},
        {"name": "SUPABASE_DB_URL", "value": "postgresql://<PLACEHOLDER>:<PLACEHOLDER>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"},
        {"name": "EMBEDDING_URL", "value": ""},
        {"name": "JWT_SECRET", "value": "<PLACEHOLDER>"},
        {"name": "SUPABASE_DB_PORT", "value": "6543"},
        {"name": "REDIS_ENABLED", "value": "false"},
        {"name": "MIGRATION_ENABLED", "value": "true"},
        {"name": "SUPABASE_DB_PASSWORD", "value": "<PLACEHOLDER>"},
        {"name": "SUPABASE_DB_NAME", "value": "postgres"},
        {"name": "SUPABASE_DB_HOST", "value": "aws-0-ap-southeast-1.pooler.supabase.com"},
        {"name": "GEMINI_EMBEDDING_MODEL", "value": "gemini-embedding-001"},
        {"name": "EMBEDDING_ENABLED", "value": "false"},
        {"name": "PORT", "value": "3000"},
        {"name": "EMBEDDING_DIMENSION", "value": "3072"},
        {"name": "GEMINI_API_KEYS", "value": "<PLACEHOLDER_KEY_1>,<PLACEHOLDER_KEY_2>,<PLACEHOLDER_KEY_3>,<PLACEHOLDER_KEY_4>"},
        {"name": "GEMINI_CHAT_MODEL", "value": "gemini-2.0-flash-lite"},
        {"name": "CLIENT_URL", "value": "https://cooksmart.netlify.app,https://cookssmart.netlify.app,https://cooksmart.click"},
        {"name": "CORS_ORIGIN", "value": "https://cooksmart.netlify.app,https://cookssmart.netlify.app,https://cooksmart.click,https://api.cooksmart.click,http://localhost:3000,http://localhost:5173,http://localhost:8080"},
        {"name": "ELASTICSEARCH_ENABLED", "value": "false"},
        {"name": "SUPABASE_ANON_KEY", "value": "<PLACEHOLDER>"},
        {"name": "YOLO_SERVICE_CLOUD_URL", "value": "http://cooksmart-prod-v2-yolo.cooksmart.local:8000"},
        {"name": "MLOPS_ENABLED", "value": "true"},
        {"name": "ELASTICSEARCH_URL", "value": ""},
        {"name": "NODE_ENV", "value": "production"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/cooksmart-backend",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "family": "cooksmart-backend-task",
  "taskRoleArn": "arn:aws:iam::294060270105:role/cooksmart-backend-task-role",
  "executionRoleArn": "arn:aws:iam::294060270105:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096"
}
